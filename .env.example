# ==============================================================================
# LogicWhileLiRE — Client Environment Configuration Template
# Brand: LogicWhileLiRE | "Logic. While. LiRE."
# ==============================================================================
# Copy this file to client/.env and fill in the values for your deployment.
# All VITE_* variables are bundled into the client browser build — NEVER put secrets here!
# ==============================================================================

# ── Backend API & WebSocket Connectivity ─────────────────────────────────────
# Primary backend API URL (e.g. Render service URL or custom domain https://api.yourdomain.com)
# [REQUIRED in production — cannot be empty or default to localhost in production builds]
VITE_API_URL=https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket / Socket.io server endpoint for live proctoring, monitor wall, and candidate lobby
VITE_SOCKET_URL=https://api.yourdomain.com

# ── Supabase (Optional client-side direct queries) ───────────────────────────
# Public Supabase project URL (safe for browser exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key (safe for browser exposure with Row Level Security enabled)
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Client Feature Flags (Optional) ──────────────────────────────────────────
# Enable or disable active client-side proctoring engine (webcam, fullscreen, tab-switch)
VITE_ENABLE_PROCTORING=true

# Enable or disable public leaderboard view for completed exam codes
VITE_ENABLE_LEADERBOARD=true

# ── Observability & Monitoring (Optional) ────────────────────────────────────
# Sentry DSN for frontend browser exception monitoring (leave blank to disable)
VITE_SENTRY_DSN=
